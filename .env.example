# ---- Core ----
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# MongoDB (docker-compose service "mongo")
MONGODB_URI=mongodb://jobpilot:change-me@localhost:27017/jobpilot?authSource=admin
MONGODB_DB=jobpilot
# 32-byte base64 key that wraps per-user data keys. Generate: openssl rand -base64 32
# In production load this from a secrets manager / Vault, never commit it.
MASTER_KEY=
# Set true behind HTTPS so cookies get the Secure flag and __Host- prefix
COOKIE_SECURE=false
# Only the first account can register (single-user MVP)
ALLOW_REGISTRATION=true

# ---- LLM (Ollama) ----
# Docker Compose + Ollama installed on your computer: http://host.docker.internal:11434
# Ollama inside Docker (--profile bundled-ollama): http://ollama:11434   |   npm run dev: http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434
# CPU-friendly default. Alternatives: llama3.2:3b, phi3.5:3.8b, qwen2.5:7b (GPU)
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_MS=120000

# ---- Resume storage ----
STORAGE_DIR=./storage
# Optional ClamAV daemon for upload scanning (host:port)
CLAMAV_HOST=

# ---- Gmail job-alert discovery through an MCP server (read-only tools only) ----
# Example: an open-source Gmail MCP server started over stdio
MCP_GMAIL_COMMAND=
MCP_GMAIL_ARGS=
MCP_GMAIL_SEARCH_TOOL=search_emails
MCP_GMAIL_READ_TOOL=read_email
MCP_GMAIL_QUERY=from:(jobalerts-noreply@linkedin.com OR naukri.com) newer_than:7d

# ---- docker-compose only ----
# Set to bundled-ollama to run Ollama inside Docker (then OLLAMA_URL=http://ollama:11434)
COMPOSE_PROFILES=
# Password for the MongoDB root user created on first start. Generate: openssl rand -base64 24
MONGO_PASSWORD=

# ---- Automatic job discovery (set with set-job-sources.ps1) ----
# Gmail: read-only IMAP access to your LinkedIn / Naukri job-alert emails. Use a Google app password.
GMAIL_IMAP_USER=
GMAIL_IMAP_APP_PASSWORD=
# Adzuna India job search API (free): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# How often discovery runs automatically (hours, 0 = only when you click "Find jobs now")
DISCOVERY_INTERVAL_HOURS=4
# Cap on new jobs scored per run (CPU scoring takes up to ~1 min per job)
DISCOVERY_MAX_NEW_PER_RUN=30
